# =============================================================================
# Bamero – environment template. Copy to ../bamero.env (outside the web root),
# fill in every value, never commit the real file.
# wp-config.php refuses to boot (HTTP 500) when a REQUIRED value is missing.
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
TABLE_PREFIX=wp_

# --- Authentication keys and salts (REQUIRED) --------------------------------
# Generate with: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# --- Site ---------------------------------------------------------------------
WP_HOME=https://example.com
WP_SITEURL=https://example.com
WP_ENVIRONMENT_TYPE=production
BAMERO_ENVIRONMENT=production
WP_DEBUG=0
WP_DEBUG_LOG=0
WP_CACHE=1
DISABLE_WP_CRON=1
DISALLOW_FILE_MODS=1
CDN_ENABLED=0
CDN_URL=

# --- Optional Redis object cache (only with the official Redis Object Cache plugin)
WP_REDIS_HOST=127.0.0.1
WP_REDIS_PORT=6379
WP_REDIS_TIMEOUT=1
WP_REDIS_PREFIX=wp_

# --- Bamero production core ---------------------------------------------------
# Random 32+ byte secrets; health token protects /wp-json/bamero/v1/health/ready
BAMERO_HEALTH_TOKEN=
BAMERO_INTERNAL_ID_SALT=

# --- SMS (SMS.ir "verify" templates) ------------------------------------------
SMS_PROVIDER=sms_ir
SMS_IR_API_KEY=
SMS_IR_API_BASE_URL=https://api.sms.ir/v1
SMS_TIMEOUT=5
SMS_IR_TEMPLATE_LOGIN_OTP=
SMS_IR_TEMPLATE_ORDER_PROCESSING=
SMS_IR_TEMPLATE_ORDER_DELIVERED=
SMS_IR_TEMPLATE_ORDER_CANCELLED=
SMS_IR_TEMPLATE_PAYMENT_FAILED=
SMS_IR_TEMPLATE_REFUND_COMPLETED=
# Owner notifications from the contact / colour-consultation forms
# (template parameters: Name, Mobile)
SMS_IR_TEMPLATE_CONTACT_REQUEST=
SMS_IR_TEMPLATE_COLOR_CONSULTATION=
# Template parameter names (defaults shown)
SMS_IR_OTP_PARAMETER=Code
SMS_IR_ORDER_PARAMETER=OrderId
SMS_IR_NAME_PARAMETER=Name
SMS_IR_MOBILE_PARAMETER=Mobile
BAMERO_ENABLE_SMS_IN_STAGING=false

# --- ZarinPal v4 ----------------------------------------------------------------
ZARINPAL_MERCHANT_ID=
ZARINPAL_API_BASE_URL=https://payment.zarinpal.com/pg/v4
ZARINPAL_STARTPAY_URL=https://payment.zarinpal.com/pg/StartPay
ZARINPAL_CURRENCY=IRR
BAMERO_ENABLE_PAYMENT_IN_STAGING=false
