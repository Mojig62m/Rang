# Copy via: bash setup-env.sh  (preferred — generates secrets)
# Or copy this file to .env and fill manually.
# Never commit a real .env. All values below are placeholders or empty.

DB_NAME=bamero_db
DB_USER=bamero_user
DB_PASSWORD=
DB_HOST=localhost
DB_ROOT_PASSWORD=
TABLE_PREFIX=wp_bamero_

AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

WP_ENVIRONMENT_TYPE=production
WP_DEBUG=0
WP_DEBUG_LOG=0
DISALLOW_FILE_MODS=1

# --- Owner only ---
# Full site URL without trailing slash, e.g. https://rang.example.ir
DOMAIN=
# One-time WordPress core admin account (internal-only e-mail; no customer mail).
WP_ADMIN_USER=bamero_admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@bamero.internal

# Salt used to derive the internal, non-routable customer identifier mailbox.
# Required by the WordPress user schema; never used for auth or messaging.
BAMERO_INTERNAL_ID_SALT=

# --- Mobile-only transactional notification provider (SMS.ir) ---
# Keep all keys in a secret manager; never commit real values.
SMS_PROVIDER=sms_ir
SMS_TIMEOUT=5
SMS_IR_API_BASE_URL=https://api.sms.ir/v1
SMS_IR_API_KEY=
SMS_IR_OTP_PARAMETER=Code
SMS_IR_ORDER_PARAMETER=OrderId
SMS_IR_TEMPLATE_LOGIN_OTP=
SMS_IR_TEMPLATE_ORDER_PROCESSING=
SMS_IR_TEMPLATE_ORDER_DELIVERED=
SMS_IR_TEMPLATE_ORDER_CANCELLED=
SMS_IR_TEMPLATE_PAYMENT_FAILED=
SMS_IR_TEMPLATE_REFUND_COMPLETED=

# --- Zarinpal official v4 request/verify API ---
# Set only on the production host; keep the merchant id in a secret manager.
ZARINPAL_API_BASE_URL=https://payment.zarinpal.com/pg/v4
ZARINPAL_MERCHANT_ID=
ZARINPAL_CURRENCY=IRT
BAMERO_PAYMENT_WEBHOOK_SECRET=
